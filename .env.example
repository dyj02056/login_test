# Supabase 프로젝트 REST 엔드포인트와 publishable(anon) 키
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co/rest/v1/
SUPABASE_KEY=your-publishable-or-anon-key

# supabase_setup.sql 을 실행하면 마지막에 출력되는 값
SUPABASE_RPC_SECRET=uuid-printed-by-the-sql-script

# Flask 세션 서명용. 아래 명령으로 생성:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=generate-a-long-random-hex-string

# 비상용 관리자 (DB 의 관리자 계정과 별개로 항상 로그인 가능)
ADMIN_USERNAME=your-admin-username
ADMIN_PASSWORD=your-admin-password

# 선택: 세션 유효성을 다시 확인하기까지의 최대 지연(초). 기본 60.
# 계정 정지·권한 해제가 반영되기까지 걸리는 시간입니다.
# 0 으로 두면 즉시 반영되지만 모든 요청에 DB 왕복이 추가됩니다.
SESSION_CHECK_INTERVAL=60

# 선택: 비밀번호 재설정 메일 발송. 없으면 관리자가 링크를 직접 전달합니다.
RESEND_API_KEY=
RESEND_FROM=onboarding@resend.dev
